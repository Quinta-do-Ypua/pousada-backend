# Banco de dados da aplicação
DB_NAME=pousada
DB_USER=troque_aqui
DB_PASSWORD=troque_aqui

# Banco de dados do Keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=troque_aqui

# Admin do Keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=troque_aqui

# URLs do Keycloak (IP público da Oracle Cloud ou domínio)
KEYCLOAK_PUBLIC_URL=https://SEU_DOMINIO_OU_IP:14082
KEYCLOAK_AUTH_SERVER=https://SEU_DOMINIO_OU_IP:14082/realms/quinta-ypua
KEYCLOAK_ADMIN_SERVER=https://SEU_DOMINIO_OU_IP:14082/admin/realms/quinta-ypua
KEYCLOAK_CLIENT_ID=ypua-client-front
KEYCLOAK_CLIENT_SECRET=troque_aqui

# SendGrid
SENDGRID_EMAIL=seu@email.com
SENDGRID_KEY=SG.troque_aqui

# MinIO (ou outro S3-compatible)
MINIO_URL=https://seu-minio.com
MINIO_ACCESS_KEY=troque_aqui
MINIO_SECRET_KEY=troque_aqui
MINIO_BUCKET_NAME=pousada
MINIO_REGION=us-east-1

# CORS — colocar a URL do deploy na Vercel após o primeiro deploy
CORS_ALLOWED_ORIGINS=https://SEU-APP.vercel.app,http://localhost:4200